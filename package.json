{
  "name": "open-lyric-plugin-player",
  "version": "0.1.5",
  "description": "Strum player for Open Lyric — hear a song's strumming patterns and every chord on guitars, keyboards, ukuleles and basses.",
  "license": "MIT",
  "author": "raksa <eng.raksa@gmail.com>",
  "homepage": "https://github.com/raksa/open-lyric/tree/main/packages/open-lyric-plugin-player#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raksa/open-lyric.git",
    "directory": "packages/open-lyric-plugin-player"
  },
  "bugs": {
    "url": "https://github.com/raksa/open-lyric/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./*.md": "./*.md",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "*.md",
    "LICENSE"
  ],
  "keywords": [
    "open-lyric",
    "strumming",
    "chords",
    "guitar",
    "ukulele",
    "webaudiofont"
  ],
  "dependencies": {
    "@tombatossals/chords-db": "^0.5.1",
    "@tonaljs/chord": "^6.1.2",
    "@tonaljs/interval": "^5.1.0",
    "@tonaljs/key": "^4.11.2",
    "@tonaljs/note": "^4.12.1",
    "svguitar": "^2.5.1"
  },
  "peerDependencies": {
    "open-lyric": "^0.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
